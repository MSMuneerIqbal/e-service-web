# Copy to .env.local for local development.
# On Vercel, set these under Project -> Settings -> Environment Variables.
#
# There are no secrets here. This site is fully static - it has no API routes,
# no serverless functions and no server-side credentials of any kind.

# --- Site ---
# Absolute origin, no trailing slash. Used for canonicals, OG URLs and sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Consultation form ---
# Web3Forms access key. Get one free at https://web3forms.com - enter the email
# address where you want leads delivered and they send you a key. No account.
#
# This key is PUBLIC by design. It only identifies which inbox a submission
# belongs to and grants no read access, which is why NEXT_PUBLIC_ is correct
# here. Never use that prefix for an actual secret.
#
# Without it, the form renders but tells visitors plainly that it is not
# connected, rather than silently discarding leads.
NEXT_PUBLIC_WEB3FORMS_KEY=
