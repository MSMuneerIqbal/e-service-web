# Copy to .env.local and fill in. Never commit .env.local (Constitution §28).

# --- Site ---
# Absolute origin, no trailing slash. Used for canonicals, OG URLs and sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Consultation form delivery (required for the form to send) ---
# Resend API key. Server-only — must never be prefixed NEXT_PUBLIC_.
RESEND_API_KEY=
# Where consultation requests are delivered.
BUSINESS_INBOX=
# Verified sender address on your Resend domain.
MAIL_FROM=

# --- Rate limiting (optional) ---
# Without these the API falls back to per-instance in-memory limiting,
# which is best-effort only on serverless. Set both for production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
