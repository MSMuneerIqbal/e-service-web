{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Node's type stripper resolves the real file, so test imports carry the
    // .ts extension. The app build excludes this directory, so the two
    // resolution styles never collide.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "../src/**/*.ts"],
  "exclude": ["../node_modules"]
}
